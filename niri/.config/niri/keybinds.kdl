prefer-no-csd

spawn-at-startup "noctalia"
spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store &"
spawn-at-startup "sh" "-c" "exec ~/.local/bin/alsa-unmute.sh"

binds {
    Mod+Return { spawn "alacritty"; }
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Q { close-window; }
    Mod+Backspace { spawn-sh "noctalia msg panel-toggle session"; }

    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Up    { focus-workspace-up; }
    Mod+Down  { focus-workspace-down; }

    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Up    { focus-workspace-up; }
    Mod+Ctrl+Down  { focus-workspace-down; }
    
    Mod+H { focus-column-or-monitor-left; }
    Mod+K { focus-column-or-monitor-right; }
    Mod+J { spawn-sh "~/.local/bin/niri-focus-down.sh"; }
    Mod+U { spawn-sh "~/.local/bin/niri-focus-up.sh"; }

    Mod+Ctrl+H  { focus-monitor-left; }
    Mod+Ctrl+K { focus-monitor-right; }
    Mod+Ctrl+U    { focus-workspace-up; }
    Mod+Ctrl+J  { focus-workspace-down; }
    
    Mod+Semicolon { focus-column-right; }

    Mod+Tab { toggle-overview; }
    Mod+Ctrl+Tab { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    Mod+F { maximize-column; }
    Mod+W { toggle-window-floating; }
    Alt+Return { fullscreen-window; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+B { spawn "zen-browser"; }
    Mod+P { spawn "nautilus"; }
    Mod+M { spawn "spotify-launcher"; }
    Mod+E {spawn "emacsclient" "-c"; }

    Mod+Shift+R { spawn "niri" "msg" "action" "load-config-file"; }
    Mod+Ctrl+O { show-hotkey-overlay; }
    Mod+Ctrl+Q { spawn-sh "noctalia msg panel-toggle session"; }

    Mod+F1 { spawn "~/.local/bin/mode-dev.sh"; }
    Mod+F2 { spawn "~/.local/bin/mode-gaming.sh"; }
    Mod+F3 { spawn "~/.local/bin/mode-music.sh"; }
    Mod+F4 { spawn "~/.local/bin/mode-normal.sh"; }

    Mod+Shift+w { spawn-sh "noctalia msg wallpaper-random"; }
    Mod+Ctrl+t { spawn-sh "noctalia msg panel-toggle noctalia/wallhaven:browser"; }
    Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Mod+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+C { spawn-sh "noctalia msg panel-toggle launcher /calc"; }
    Mod+Ctrl+E { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
    Mod+L { spawn-sh "noctalia msg session lock"; }
    
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }

    F9 allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    F10 allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    F11 allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }

    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}

recent-windows {
    binds {
        Alt+Tab { next-window scope="all"; }
        Alt+Ctrl+Tab { previous-window scope="output"; }
        Alt+grave { next-window scope="all" filter="app-id"; }
        Alt+Shift+grave { previous-window scope="all" filter="app-id"; }
        Alt+Shift+Tab { next-window scope="workspace"; }
        Ctrl+Alt+Shift+Tab { previous-window scope="workspace"; }
        Ctrl+Alt+grave { next-window scope="workspace" filter="app-id"; }
        Ctrl+Alt+Shift+grave { previous-window scope="workspace" filter="app-id"; }
    }
}

