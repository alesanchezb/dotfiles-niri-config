// -*- mode: jsonc -*-
{
    "height": 24,
    "spacing": 4,
    "modules-left": [
        "niri/workspaces"
    ],
    "modules-right": [
        "battery",
        "clock"
    ],
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },
    "battery": {
        "bat": "BAT0",
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format": "{:%H:%M}"
    }
}
